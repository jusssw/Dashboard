# Port the Vite dev server listens on.
PORT=5173

# Base path the app is served from. Use "/" for local dev.
BASE_PATH=/

# Where the Vite dev server should forward /api requests.
# Match this to the API server's PORT above.
API_PROXY_TARGET=http://localhost:5000

# Supabase project settings, for the login screen (Project Settings -> API
# in the Supabase dashboard). Use the *publishable*/anon key here — never
# the secret key, this one ends up in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
